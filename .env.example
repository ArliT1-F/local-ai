# Copy to .env and fill in. .env is git-ignored; never commit real keys.
#   cp .env.example .env && chmod 600 .env

# --- Abliteration (hosted API) ------------------------------------------
# https://abliteration.ai/console  ->  API keys
ABLIT_KEY=ak_REPLACE_ME

# --- Firecrawl MCP ------------------------------------------------------
# https://www.firecrawl.dev/app/api-keys  (starts with fc-)
# If unset, the firecrawl MCP server is skipped by scripts/verify-all.sh
# and tools that call it will fail with an auth error.
FIRECRAWL_API_KEY=fc_REPLACE_ME

# --- Optional: self-hosted abliterated model on RunPod (step 3) ---------
# Base URL of your RunPod vLLM pod's OpenAI-compatible endpoint.
# RUNPOD_LLM_BASE_URL=https://<pod-id>-8000.proxy.runpod.net/v1
# RUNPOD_LLM_API_KEY=sk-local-REPLACE_ME

# --- Harness ------------------------------------------------------------
# Do NOT put DSH_* variables in this file: dsh loads .env itself and refuses
# variables that decide how the process starts. Export them in your shell
# instead, e.g.
#
#   export DSH_HOME=/absolute/path/to/dsh-home   # default: <repo>/.dsh-home
#   export DSH_PORT=3080                          # default: 3080
#   export DSH_HOST=127.0.0.1                     # bind address (no wildcards)
